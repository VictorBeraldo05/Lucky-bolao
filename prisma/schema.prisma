generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  USER
  ADMIN
}

enum WalletTransactionType {
  CREDIT_PURCHASE
  MANUAL_CREDIT
  SHARE_PURCHASE
  PRIZE_CREDIT
  REFERRAL_BONUS
  REFUND
  WITHDRAWAL
}

enum WalletTransactionStatus {
  PENDING
  COMPLETED
  CANCELED
  REVERSED
}

enum PaymentStatus {
  PENDING
  APPROVED
  CANCELED
  REFUNDED
}

enum WalletTopupStatus {
  PENDING
  PAID
  REJECTED
  EXPIRED
  MANUAL_REVIEW
}

enum CartStatus {
  OPEN
  CHECKED_OUT
  CANCELLED
}

enum PoolStatus {
  OPEN
  SOLD_OUT
  CLOSED
  WAITING_DRAW
  AWARDED
  NOT_AWARDED
  CANCELED
}

enum PurchaseStatus {
  PENDING
  PAID
  CANCELED
  REFUNDED
}

enum NotificationType {
  INFO
  SUCCESS
  WARNING
}

enum AuditActionType {
  LOGIN
  REGISTER
  CREDIT_ADDED
  SHARE_PURCHASED
  PURCHASE_CANCELED
  POOL_UPDATED
  RESULT_PUBLISHED
  PRIZE_DISTRIBUTED
  ADMIN_ACTION
  STATUS_CHANGED
}

model User {
  id                String              @id @default(cuid())
  inviteCode        String              @unique @default(cuid())
  name              String
  email             String              @unique
  phone             String?
  passwordHash      String
  cpf               String?             @unique
  role              UserRole            @default(USER)
  isActive          Boolean             @default(true)
  referredByUserId  String?
  referralRewardedAt DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  referredBy        User?               @relation("UserReferral", fields: [referredByUserId], references: [id], onDelete: SetNull)
  referredUsers     User[]              @relation("UserReferral")
  wallet            Wallet?
  cart              Cart?
  purchases         Purchase[]
  poolShares        PoolShare[]
  topups            WalletTopup[]
  prizes            Prize[]
  notifications     Notification[]
  payments          Payment[]
  auditLogs         AuditLog[]
  authoredLogs      AuditLog[]          @relation("AuditActor")
  WalletTransaction WalletTransaction[]
}

model Cart {
  id         String      @id @default(cuid())
  userId     String      @unique
  status     CartStatus  @default(OPEN)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  items      CartItem[]
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CartItem {
  id         String   @id @default(cuid())
  cartId     String
  poolId     String
  quantity   Int
  unitPrice  Decimal  @db.Decimal(12, 2)
  totalPrice Decimal  @db.Decimal(12, 2)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  cart Cart @relation(fields: [cartId], references: [id], onDelete: Cascade)
  pool Pool @relation(fields: [poolId], references: [id], onDelete: Restrict)
}

model Wallet {
  id           String              @id @default(cuid())
  userId       String              @unique
  balance      Decimal             @db.Decimal(12, 2)
  bonusBalance Decimal             @default(0) @db.Decimal(12, 2)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions WalletTransaction[]
}

model WalletPackage {
  id          Int                @id @default(autoincrement())
  title       String
  description String?
  price       Decimal            @db.Decimal(12, 2)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  topups      WalletTopup[]

  @@unique([title])
}

model WalletTopup {
  id                  String            @id @default(cuid())
  userId              String
  packageId           Int
  providerChargeId    String?
  correlationId       String?
  payerCpfExpected    String?
  status              WalletTopupStatus @default(PENDING)
  qrCodeText          String?
  qrCodeImageBase64   String?
  paymentLinkUrl      String?
  expiresAt           DateTime?
  providerPayload     Json?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  package WalletPackage @relation(fields: [packageId], references: [id], onDelete: Restrict)
}

model WalletTransaction {
  id            String                  @id @default(cuid())
  walletId      String
  userId        String
  type          WalletTransactionType
  status        WalletTransactionStatus @default(COMPLETED)
  amount        Decimal                 @db.Decimal(12, 2)
  balanceBefore Decimal                 @db.Decimal(12, 2)
  balanceAfter  Decimal                 @db.Decimal(12, 2)
  description   String
  referenceType String?
  referenceId   String?
  metadata      Json?
  createdAt     DateTime                @default(now())
  wallet        Wallet                  @relation(fields: [walletId], references: [id], onDelete: Cascade)
  user          User                    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([walletId, createdAt])
}

model Lottery {
  id          String            @id @default(cuid())
  slug        String            @unique
  name        String
  description String?
  minNumbers  Int
  maxNumbers  Int
  numberStart Int
  numberEnd   Int
  drawDays    String[]
  basePrice   Decimal           @db.Decimal(12, 2)
  accentColor String            @default("#b226b2")
  isActive    Boolean           @default(true)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  gameTypes   LotteryGameType[]
  contests    Contest[]
  pools       Pool[]
}

model LotteryGameType {
  id          String   @id @default(cuid())
  lotteryId   String
  name        String
  slug        String
  description String?
  minNumbers  Int
  maxNumbers  Int
  strategy    String
  isActive    Boolean  @default(true)
  config      Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  lottery     Lottery  @relation(fields: [lotteryId], references: [id], onDelete: Cascade)
  pools       Pool[]

  @@unique([lotteryId, slug])
}

model Contest {
  id            String         @id @default(cuid())
  lotteryId     String
  contestNumber Int
  drawDate      DateTime
  status        String         @default("scheduled")
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  lottery       Lottery        @relation(fields: [lotteryId], references: [id], onDelete: Cascade)
  result        ContestResult?
  pools         Pool[]

  @@unique([lotteryId, contestNumber])
  @@index([drawDate])
}

model ContestResult {
  id             String   @id @default(cuid())
  contestId      String   @unique
  drawnNumbers   Int[]
  prizeBreakdown Json?
  source         String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  contest        Contest  @relation(fields: [contestId], references: [id], onDelete: Cascade)
}

model Pool {
  id              String          @id @default(cuid())
  code            String          @unique
  lotteryId       String
  gameTypeId      String
  contestId       String
  title           String
  description     String?
  status          PoolStatus      @default(OPEN)
  totalValue      Decimal         @db.Decimal(12, 2)
  sharePrice      Decimal         @db.Decimal(12, 2)
  totalShares     Int
  availableShares Int
  relativeChance  String?
  ticketImageUrl  String?
  ticketCode      String?
  metadata        Json?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  lottery         Lottery         @relation(fields: [lotteryId], references: [id], onDelete: Restrict)
  gameType        LotteryGameType @relation(fields: [gameTypeId], references: [id], onDelete: Restrict)
  contest         Contest         @relation(fields: [contestId], references: [id], onDelete: Restrict)
  games           PoolGame[]
  shares          PoolShare[]
  purchaseItems   PurchaseItem[]
  cartItems       CartItem[]
  Prize           Prize[]

  @@index([lotteryId, contestId, status])
}

model PoolGame {
  id          String   @id @default(cuid())
  poolId      String
  title       String
  numbers     Int[]
  hits        Int?
  prizeAmount Decimal? @db.Decimal(12, 2)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  pool        Pool     @relation(fields: [poolId], references: [id], onDelete: Cascade)
}

model PoolShare {
  id             String        @id @default(cuid())
  poolId         String
  userId         String
  purchaseItemId String?
  quantity       Int
  unitPrice      Decimal       @db.Decimal(12, 2)
  totalPrice     Decimal       @db.Decimal(12, 2)
  createdAt      DateTime      @default(now())
  pool           Pool          @relation(fields: [poolId], references: [id], onDelete: Cascade)
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  purchaseItem   PurchaseItem? @relation(fields: [purchaseItemId], references: [id], onDelete: SetNull)
  prizes         Prize[]

  @@index([userId, createdAt])
  @@index([poolId])
}

model Purchase {
  id          String         @id @default(cuid())
  userId      String
  status      PurchaseStatus @default(PAID)
  totalAmount Decimal        @db.Decimal(12, 2)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items       PurchaseItem[]
}

model PurchaseItem {
  id         String      @id @default(cuid())
  purchaseId String
  poolId     String
  quantity   Int
  unitPrice  Decimal     @db.Decimal(12, 2)
  totalPrice Decimal     @db.Decimal(12, 2)
  createdAt  DateTime    @default(now())
  purchase   Purchase    @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  pool       Pool        @relation(fields: [poolId], references: [id], onDelete: Restrict)
  poolShares PoolShare[]
}

model Payment {
  id        String        @id @default(cuid())
  userId    String
  amount    Decimal       @db.Decimal(12, 2)
  status    PaymentStatus @default(PENDING)
  method    String        @default("manual")
  reference String?
  metadata  Json?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Prize {
  id          String    @id @default(cuid())
  userId      String
  poolId      String
  poolShareId String
  amount      Decimal   @db.Decimal(12, 2)
  hitCount    Int
  description String
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  poolShare   PoolShare @relation(fields: [poolShareId], references: [id], onDelete: Cascade)
  pool        Pool      @relation(fields: [poolId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType @default(INFO)
  title     String
  message   String
  readAt    DateTime?
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model AuditLog {
  id           String          @id @default(cuid())
  actorUserId  String?
  userId       String?
  action       AuditActionType
  entityType   String
  entityId     String
  previousData Json?
  newData      Json?
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime        @default(now())
  actor        User?           @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  user         User?           @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([createdAt])
}
